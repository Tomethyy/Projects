---
import { contractTypes } from '../data/contractTypes';
---

<section id="contracts" class="section">
  <div class="container">
    <p class="section-label">// Contract Types</p>
    <h2 class="section-title">Request a Service</h2>
    <div class="grid-3">
      {contractTypes.map((type) => (
        <a href={`/contracts?type=${type.id}`} class="panel contract-card">
          <span class="icon" aria-hidden="true">{type.icon}</span>
          <h3>{type.title}</h3>
          <p>{type.description}</p>
          <span class="link-hint mono">Open contract form →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contract-card {
    display: block;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .contract-card:hover {
    color: inherit;
    transform: translateY(-2px);
  }

  .icon {
    font-size: 1.75rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .contract-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .contract-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .link-hint {
    font-size: 0.75rem;
    color: var(--accent-cyan);
  }
</style>
