---
import statusData from '../data/status.json';

const { entries, lastUpdated } = statusData;
const updated = new Date(lastUpdated).toLocaleString('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<section id="status" class="section status-section">
  <div class="container">
    <p class="section-label">// Operations Status</p>
    <div class="status-header">
      <h2 class="section-title">Live Status Board</h2>
      <span class="live-badge"><span class="pulse"></span> LIVE</span>
    </div>
    <div class="status-grid">
      {entries.map((entry) => (
        <div class="panel status-card">
          <div class="status-row">
            <span class="mono label">{entry.label}</span>
            <span class:list={['mono', 'status-value', `status-${entry.level}`]}>{entry.status}</span>
          </div>
          <p class="detail">{entry.detail}</p>
        </div>
      ))}
    </div>
    <p class="updated mono">Last updated: {updated}</p>
  </div>
</section>

<style>
  .status-section {
    padding-top: 3rem;
  }

  .status-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .status-header .section-title {
    margin-bottom: 0;
  }

  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--accent-green);
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(61, 255, 138, 0.4);
    border-radius: var(--radius);
  }

  .pulse {
    width: 8px;
    height: 8px;
    background: var(--accent-green);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgba(61, 255, 138, 0.5);
    }
    50% {
      opacity: 0.7;
      box-shadow: 0 0 0 6px rgba(61, 255, 138, 0);
    }
  }

  .status-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  .status-card {
    padding: 1.25rem;
  }

  .status-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .status-value {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .status-online {
    color: var(--accent-green);
  }

  .detail {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .updated {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
